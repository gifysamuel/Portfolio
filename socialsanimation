    .socials a{

    animation:floatIcon 4s ease-in-out infinite;

    }

    
    .socials a:nth-child(2){

    animation-delay:.4s;

    }

    .socials a:nth-child(3){

    animation-delay:.8s;

    }

    .socials a:nth-child(4){

    animation-delay:1.2s;

    }

    @keyframes floatIcon{

    0%{

    transform:translateY(0);

    }

    50%{

    transform:translateY(-8px);

    }

    100%{

    transform:translateY(0);

    }

    }
